NODE_ENV=development
PORT=5001

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=abdi_adama_development
DB_USER=abdi_adama_app
DB_PASSWORD=
DB_SSL=false
DB_APPLICATION_NAME=abdi-adama-api
# Per backend process. Size this against PostgreSQL max_connections and the
# number of PM2/backend instances; 10 is the safe application default.
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=120000
DB_IDLE_TRANSACTION_TIMEOUT_MS=300000
DB_CONNECTION_MAX_LIFETIME_SECONDS=1800

JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

MACHINE_API_KEY=
ZK_PASSWORD=0

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

FRONTEND_URL=http://localhost:5173
GRADE_SUBMISSION_UNLOCK_DAYS=60

# Required only by `npm run seed:superadmin`.
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
SEED_SCHOOL_ADMIN_EMAIL=
SEED_SCHOOL_ADMIN_PASSWORD=
SEED_VICE_PRINCIPAL_EMAIL=
SEED_VICE_PRINCIPAL_PASSWORD=
SEED_AUDITOR_EMAIL=
SEED_AUDITOR_PASSWORD=
SEED_SILO_STUDENT_PASSWORD=
SEED_FINANCE_CLERK_PASSWORD=

# Required only by src/scripts/update_passwords.ts.
PASSWORD_UPDATE_USERNAME=
PASSWORD_UPDATE_VALUE=

# Required only by the database-writing integration suites.
TEST_DATABASE_HOST_ALLOWLIST=127.0.0.1
TEST_DATABASE_NAME_ALLOWLIST=abdi_adama_test
TEST_SUPER_ADMIN_EMAIL=
TEST_SUPER_ADMIN_PASSWORD=
TEST_SCHOOL_ADMIN_EMAIL=
TEST_SCHOOL_ADMIN_PASSWORD=
TEST_VICE_PRINCIPAL_EMAIL=
TEST_VICE_PRINCIPAL_PASSWORD=
TEST_AUDITOR_EMAIL=
TEST_AUDITOR_PASSWORD=
